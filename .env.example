# --- Database ---
# Real, working, zero-config: uses Node's built-in SQLite (node:sqlite,
# Node 22+) — no server to install, no external binary download. The file
# is created automatically at first run. Leave unset to use the default
# path below, or point it somewhere else (e.g. a persistent volume in prod).
SQLITE_PATH="./data/swiftdrop.db"

# --- Auth (NextAuth) ---
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# --- Stripe (payments to merchants, payouts to couriers) — not yet wired in ---
STRIPE_SECRET_KEY="sk_test_xxx"
STRIPE_WEBHOOK_SECRET="whsec_xxx"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_xxx"

# --- Maps / Routing — not required for the live map (that uses free
# OpenStreetMap tiles + the browser's own GPS). Only needed later for
# address autocomplete and real road-distance pricing. ---
NEXT_PUBLIC_MAPS_PROVIDER="mapbox" # or "google"
NEXT_PUBLIC_MAPBOX_TOKEN="pk.xxx"
GOOGLE_MAPS_SERVER_KEY="xxx"

# --- Notifications — not yet wired in ---
TWILIO_ACCOUNT_SID="xxx"
TWILIO_AUTH_TOKEN="xxx"
TWILIO_FROM_NUMBER="+1XXXXXXXXXX"
RESEND_API_KEY="xxx"
EMAIL_FROM="orders@yourdomain.ca"

# --- Background checks (Canadian provider) — not yet wired in ---
CERTN_API_KEY="xxx"

# --- App ---
NEXT_PUBLIC_APP_NAME="SwiftDrop"
NEXT_PUBLIC_DEFAULT_CITY="Toronto"
