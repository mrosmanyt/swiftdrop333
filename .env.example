# --- Database (PostgreSQL) ---
# Local development needs NOTHING here: with DATABASE_URL unset the app runs
# an embedded PostgreSQL (PGlite) and keeps its files in ./data/pgdata.
#
# Production (Vercel): connect Neon under Storage — it sets DATABASE_URL for
# the deployment automatically. The schema is created on first use.
#
# Set it here only to point your laptop at the hosted database, e.g. to run
# `npm run create-admin` for the live site. Copy the value from
# Vercel → Storage → your Neon database → ".env.local" tab.
# DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# --- Auth (NextAuth) ---
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# --- Stripe (payments to merchants, payouts to couriers) — not yet wired in ---
STRIPE_SECRET_KEY="sk_test_xxx"
STRIPE_WEBHOOK_SECRET="whsec_xxx"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_xxx"

# --- Maps / Routing — not required for the live map (that uses free
# OpenStreetMap tiles + the browser's own GPS). Only needed later for
# address autocomplete and real road-distance pricing. ---
GEOCODER="mapbox" # or "google" or "photon" (free, no key)
NEXT_PUBLIC_MAPS_PROVIDER="mapbox" # or "google"
NEXT_PUBLIC_MAPBOX_TOKEN="pk.xxx"
GOOGLE_MAPS_SERVER_KEY="xxx"

# --- Notifications — not yet wired in ---
TWILIO_ACCOUNT_SID="xxx"
TWILIO_AUTH_TOKEN="xxx"
TWILIO_FROM_NUMBER="+1XXXXXXXXXX"
RESEND_API_KEY="xxx"
EMAIL_FROM="orders@yourdomain.ca"

# --- Background checks (Canadian provider) — not yet wired in ---
CERTN_API_KEY="xxx"

# --- Web push notifications (driver offer alerts, customer order status) ---
# Generate once with: npx web-push generate-vapid-keys
# Leave unset and push notifications just no-op — nothing else breaks.
NEXT_PUBLIC_VAPID_PUBLIC_KEY="xxx"
VAPID_PRIVATE_KEY="xxx"
VAPID_SUBJECT="mailto:support@yourdomain.ca"

# --- Scheduled jobs ---
# Protects GET /api/cron/tick (dispatch + recurring orders + retention).
# Vercel Cron sends it automatically. Generate with: openssl rand -hex 32
CRON_SECRET=""

# --- App ---
NEXT_PUBLIC_APP_NAME="SwiftDrop"
NEXT_PUBLIC_DEFAULT_CITY="Toronto"
# Public address of this deployment. Used in the API sample shown to
# merchants; leave unset and the browser's own origin is used instead.
# NEXT_PUBLIC_APP_URL="https://app.yourdomain.ca"

# --- Security & privacy ---
# Key used to encrypt identity documents (licence, insurance) at rest.
# Generate with: openssl rand -base64 32 — and keep it safe: documents
# encrypted with it can't be read without it. If unset, a key derived from
# NEXTAUTH_SECRET is used (so rotating NEXTAUTH_SECRET would make stored
# documents unreadable — set this explicitly in production).
DATA_ENCRYPTION_KEY=""
# Where uploads are stored when self-hosting / developing locally. On Vercel
# uploads go to private Vercel Blob instead (BLOB_READ_WRITE_TOKEN).
# UPLOAD_DIR="./data/uploads"
# Only for a throwaway demo/staging deployment: allow the seeded
# @example.com accounts (public password!) to sign in in production.
# ALLOW_DEMO_ACCOUNTS="false"
# Retention windows in days (defaults shown).
# DOC_FILE_RETENTION_DAYS=30
# POD_RETENTION_DAYS=90
# NOTIFICATION_RETENTION_DAYS=90
# CHAT_RETENTION_DAYS=90
# ORDER_PII_RETENTION_DAYS=365
# ERASE_DELETED_AFTER_DAYS=30

# --- Website admin (admin console → Website) — see ADMIN-SETUP.md ---
# Nothing here is required. Email alerts for new enquiries use RESEND_API_KEY
# and EMAIL_FROM above; picture uploads use BLOB_READ_WRITE_TOKEN on Vercel.
# Set NEXT_PUBLIC_APP_URL so share pictures get a full https:// address.
